# Server Configuration
PROJECT_NAME="Web Vulnerability Scanner & AI Remediation"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretjwtkey_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (MongoDB)
# Local MongoDB:
MONGO_URI="mongodb://localhost:27017"
# Or MongoDB Atlas cloud URI:
# MONGO_URI="mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGO_DB_NAME="vuln_scanner"

# Redis & Celery Configuration
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# OWASP ZAP API Configuration
# Run OWASP ZAP locally, ensure API is enabled in Options -> API
ZAP_PROXY_URL="http://localhost:8080"
ZAP_API_KEY=""

# AI Engine (Google Gemini)
GEMINI_API_KEY="your-google-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"

# Google Cloud Platform (GCP) OAuth 2.0 Client ID
# Obtain from GCP Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=""

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
